# ==============================================================================
# FitFlow AI — Environment Configuration
# ==============================================================================

# 1. REQUIRED KEYS (Server-Side Secrets)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Used by the Express server (/api/gemini/*) to power the AI Coach
# and smart daily wellness insights. Keep this secret on the server-side only.
# In Google AI Studio, this is securely provided via the Secrets panel.
GEMINI_API_KEY=""

# 2. OPTIONAL CONFIGURATION (Runtime Injected)
# ------------------------------------------------------------------------------
# APP_URL: The external deployment or sandbox URL where this applet is hosted.
# Automatically provided by the container runtime for endpoint referencing.
APP_URL=""

# 3. DEVELOPMENT CONFIGURATION (Defaults)
# ------------------------------------------------------------------------------
# PORT: The server port (Fixed to 3000 in the container sandbox).
# NODE_ENV: development | production
PORT=3000
NODE_ENV=development
